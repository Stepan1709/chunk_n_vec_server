# URL OpenAI-совместимого сервиса эмбеддингов (vLLM и т.п.), без завершающего "/"
VEC_URL=http://localhost:8500
# Модель эмбеддингов
EMBEDDING_MODEL=BAAI/bge-m3
# Таймаут запроса к сервису эмбеддингов, секунды
REQUEST_TIMEOUT=120
# Максимум одновременных запросов к сервису эмбеддингов
MAX_CONCURRENT_EMBEDDING_REQUESTS=5
# Адрес и порт, на которых слушает сервис
SERVER_HOST=0.0.0.0
SERVER_PORT=8998
LOG_LEVEL=INFO
